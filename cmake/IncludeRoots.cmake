# Create an interface target whose only job is to add DIR to the include path.
#   add_include_root(<name> <dir> [SYSTEM])
function(add_include_root NAME DIR)
    cmake_parse_arguments(ARG "SYSTEM" "" "" ${ARGN})
    add_library(${NAME}_include_root INTERFACE)
    if(ARG_SYSTEM)
        target_include_directories(${NAME}_include_root SYSTEM INTERFACE ${DIR})
    else()
        target_include_directories(${NAME}_include_root INTERFACE ${DIR})
    endif()
    add_library(root::${NAME} ALIAS ${NAME}_include_root)
endfunction()

# Link an include root (plus optional libraries) to TARGET.
#   target_link_root(<target> <root> [SCOPE PUBLIC|PRIVATE|INTERFACE] [libs...])
# Default scope: PRIVATE for executables, INTERFACE for interface libs, PUBLIC otherwise.
function(target_link_root TARGET ROOT)
    cmake_parse_arguments(ARG "" "SCOPE" "" ${ARGN})
    if(NOT ARG_SCOPE)
        get_target_property(type ${TARGET} TYPE)
        if(type STREQUAL "EXECUTABLE")
            set(ARG_SCOPE PRIVATE)
        elseif(type STREQUAL "INTERFACE_LIBRARY")
            set(ARG_SCOPE INTERFACE)
        else()
            set(ARG_SCOPE PUBLIC)
        endif()
    endif()
    target_link_libraries(${TARGET} ${ARG_SCOPE} root::${ROOT} ${ARG_UNPARSED_ARGUMENTS})
endfunction()